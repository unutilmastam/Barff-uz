# Chiqarish sozlamalari (`pnpm release:cpanel`). Nusxa ko'chiring:
#   cp release.env.example release.env
# `release.env` repoga KIRMAYDI. Bu yerda SIR yo'q — faqat ochiq manzillar.
# Qiymatlar QURISH PAYTIDA bundle ichiga yoziladi (docs/DEPLOY-CPANEL.md §6.2).

# API manzili: https bilan va /api/v1 bilan tugashi shart.
NEXT_PUBLIC_API_BASE_URL=https://api.barff.uz/api/v1

# Ommaviy sayt va boshqa ilovalar.
NEXT_PUBLIC_SITE_URL=https://barff.uz
NEXT_PUBLIC_ADMIN_URL=https://admin.barff.uz
NEXT_PUBLIC_DEALER_URL=https://partner.barff.uz

# Qidiruv tizimlariga ochish: kontent tayyor bo'lgach `true` qiling.
NEXT_PUBLIC_ALLOW_INDEXING=false
