// BARFF platformasi — ma'lumotlar bazasi sxemasi (CLAUDE.md §10).
//
// S03 doirasi: foydalanuvchilar, rollar, ruxsatlar, tizim sozlamalari va
// audit jurnali. Mahsulot, buyurtma, ombor va yetkazib berish modellari
// keyingi qadamlarda (S09, S26, S30, S32) shu faylga qo'shiladi.

generator client {
  provider = "prisma-client-js"
  // pnpm ishchi maydonida standart joy ishonchsiz — generatsiya qilingan
  // klient aniq bir paket ichiga chiqariladi va `@barff/db` orqali ulashiladi.
  output   = "../packages/db/generated"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  // Migratsiyalarni tekshirish uchun alohida baza (prisma migrate dev).
  shadowDatabaseUrl = env("DATABASE_SHADOW_URL")
}

// =============================================================================
// FOYDALANUVCHILAR VA RUXSATLAR
// =============================================================================

/// Tizimga kira oladigan har qanday shaxs: admin, sotuvchi, omborchi,
/// logist, haydovchi yoki diler kontakti.
model User {
  id String @id @default(uuid(7)) @db.Uuid

  email String  @unique
  /// 998XXXXXXXXX ko'rinishida saqlanadi (`@barff/utils` normalizePhone).
  phone String? @unique

  /// DIQQAT: faqat HASH. Ochiq parol hech qachon saqlanmaydi (CLAUDE.md §12).
  passwordHash String

  fullName String
  isActive Boolean @default(true)

  /// Admin uchun majburiy MFA (CLAUDE.md §12) — S04 da yoqiladi.
  mfaEnabled Boolean @default(false)
  mfaSecret  String?

  lastLoginAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Yumshoq o'chirish: audit jurnalidagi havolalar buzilmasligi uchun
  /// foydalanuvchi yozuvi fizik o'chirilmaydi.
  deletedAt DateTime?

  roles           UserRole[]
  media           MediaAsset[]         @relation("MediaUploader")
  newsArticles    NewsArticle[]        @relation("NewsAuthor")
  auditLogs       AuditLog[]           @relation("AuditActor")
  settings        SystemSetting[]      @relation("SettingUpdatedBy")
  grantedRoles    UserRole[]           @relation("RoleAssignedBy")
  assignedLeads   Lead[]               @relation("LeadAssignee")
  leadEvents      LeadEvent[]          @relation("LeadEventActor")
  notifications   Notification[]       @relation("NotificationRecipient")
  refreshTokens   RefreshToken[]       @relation("UserRefreshTokens")
  refreshFamilies RefreshTokenFamily[] @relation("UserRefreshFamilies")

  /// Diler akkaunti (faqat DEALER rolidagi foydalanuvchida bo'ladi).
  dealer          Dealer?              @relation("DealerAccount")
  orderStatuses   OrderStatusHistory[] @relation("OrderStatusActor")
  reviewedDealers Dealer[]             @relation("DealerReviewer")
  dealerEvents    DealerEvent[]        @relation("DealerEventActor")
  stockMovements  StockMovement[]      @relation("StockMovementActor")

  @@index([isActive])
  @@index([createdAt])
  @@map("users")
}

/// Rol — ruxsatlar to'plami (`@barff/types` dagi ROLES bilan mos).
model Role {
  id String @id @default(uuid(7)) @db.Uuid

  /// ADMIN, SALES, WAREHOUSE, LOGISTICS, DRIVER, DEALER
  code        String  @unique
  name        String
  description String?

  /// Tizim roli — CMS orqali o'chirib bo'lmaydi.
  isSystem Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

/// Bitta aniq ruxsat, masalan `orders.status.change`.
model Permission {
  id String @id @default(uuid(7)) @db.Uuid

  code        String  @unique
  /// CMS'da guruhlab ko'rsatish uchun: `orders`, `warehouse`, ...
  group       String
  description String?

  createdAt DateTime @default(now())

  roles RolePermission[]

  @@index([group])
  @@map("permissions")
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid

  assignedAt   DateTime @default(now())
  /// Kim biriktirgani — rol o'zgarishi audit qilinadigan amal (CLAUDE.md §23).
  assignedById String?  @db.Uuid

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("RoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  createdAt DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// =============================================================================
// TIZIM
// =============================================================================

/// Runtime'da o'zgaradigan sozlamalar (CLAUDE.md §8).
/// Sirlar BU YERGA yozilmaydi — ular AWS Secrets Manager'da (§12).
model SystemSetting {
  id String @id @default(uuid(7)) @db.Uuid

  key   String @unique
  value Json

  description String?
  /// `true` bo'lsa, qiymat autentifikatsiyasiz API orqali ham berilishi mumkin.
  isPublic    Boolean @default(false)

  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid
  updatedBy   User?    @relation("SettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([isPublic])
  @@map("system_settings")
}

/// Sezgir amallar jurnali (CLAUDE.md §23).
///
/// `before`/`after` ga parol, token va boshqa sirlar YOZILMAYDI — yozuvdan
/// oldin tozalanadi.
model AuditLog {
  id String @id @default(uuid(7)) @db.Uuid

  /// Foydalanuvchi o'chirilsa ham jurnal qatori qoladi, shuning uchun
  /// bajaruvchining emaili alohida nusxa sifatida saqlanadi.
  actorId    String? @db.Uuid
  actorEmail String?
  actor      User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  /// `user.login`, `order.status.change`, `stock.adjust`, ...
  action   String
  /// Qaysi model: `User`, `Order`, `WarehouseStock`, ...
  entity   String
  entityId String?

  before Json?
  after  Json?

  ip        String?
  userAgent String?
  /// So'rov loglari bilan bog'lash uchun (S02 request-id).
  requestId String?

  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// =============================================================================
// MEDIA (S08)
// =============================================================================

enum MediaVisibility {
  /// CDN orqali hammaga ochiq (mahsulot rasmlari, zavod fotolari).
  PUBLIC
  /// Faqat imzolangan havola orqali (shartnomalar, ichki hujjatlar).
  PRIVATE
}

enum MediaKind {
  IMAGE
  DOCUMENT
}

/// Yuklangan fayl haqidagi ma'lumot (CLAUDE.md §20).
///
/// Faylning O'ZI obyekt saqlashda (S3/MinIO), bu yerda faqat metadata.
model MediaAsset {
  id String @id @default(uuid(7)) @db.Uuid

  /// Obyekt saqlashdagi kalit. Kengaytma ANIQLANGAN turdan olinadi,
  /// mijoz bergan fayl nomidan emas.
  key String @unique

  /// Mijoz yuborgan nom — faqat ko'rsatish uchun saqlanadi.
  originalName String
  /// Imzo baytlari bo'yicha ANIQLANGAN tur, sarlavhadan olingani emas.
  mimeType     String
  byteSize     Int

  kind       MediaKind
  visibility MediaVisibility @default(PRIVATE)

  width  Int?
  height Int?

  /// Rasm yuklangunicha ko'rsatiladigan kichik o'rindosh.
  blurDataUrl String?

  /// O'lcham variantlari: [{ label, key, width, format, mimeType, byteSize }].
  variants Json?

  /// Ko'p tilli alt matn (CLAUDE.md §19: alt text).
  altText Json?

  /// Bir xil faylni qayta yuklashni aniqlash uchun (sha256).
  checksum String

  uploadedById String? @db.Uuid
  uploadedBy   User?   @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  productImages    ProductImage[]
  productDocuments ProductDocument[]

  newsCovers       NewsArticle[]     @relation("NewsCover")
  certificateFiles Certificate[]     @relation("CertificateFile")
  galleryItems     GalleryItem[]     @relation("GalleryMedia")
  publicDocuments  PublicDocument[]  @relation("PublicDocumentFile")
  productionSteps  ProductionStep[]  @relation("ProductionStepMedia")
  seoImages        SeoMetadata[]     @relation("SeoOgImage")
  homepageMedia    HomepageSection[] @relation("HomepageMedia")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Yumshoq o'chirish: fayl boshqa yozuvlarda ishlatilayotgan bo'lishi mumkin.
  deletedAt DateTime?

  @@index([kind])
  @@index([visibility])
  @@index([checksum])
  @@index([createdAt])
  @@map("media_assets")
}

// =============================================================================
// MAHSULOTLAR (S09)
// =============================================================================

/// Hujjat turi: sertifikat, spetsifikatsiya yoki boshqa.
enum ProductDocumentKind {
  CERTIFICATE
  SPECIFICATION
  OTHER
}

/// Mahsulot kategoriyasi (sharbatlar, gazli ichimliklar, ...).
///
/// Ko'p tilli maydonlar JSON sifatida `{ uz, ru, en }` ko'rinishida
/// saqlanadi — `@barff/types` dagi `Localized<T>` tipiga mos.
model ProductCategory {
  id String @id @default(uuid(7)) @db.Uuid

  slug        String @unique
  /// Localized<string>
  name        Json
  /// Localized<string> | null
  description Json?

  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  /// Ichma-ich kategoriyalar uchun.
  parentId String?           @db.Uuid
  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ProductCategory[] @relation("CategoryTree")

  /// SEO meta (title, description) — Localized.
  seo Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  products   Product[]
  priceRules PriceRule[]

  @@index([isActive, displayOrder])
  @@index([parentId])
  @@map("product_categories")
}

model Product {
  id String @id @default(uuid(7)) @db.Uuid

  /// Ommaviy URL uchun. O'ZGARMASLIGI kerak — o'zgarsa, tashqi havolalar
  /// buziladi va SEO yo'qoladi.
  slug String @unique
  /// Ichki artikul. Variantlarning o'z SKU'si ham bo'ladi.
  sku  String @unique

  categoryId String          @db.Uuid
  category   ProductCategory @relation(fields: [categoryId], references: [id])

  /// Localized<string>
  name        Json
  /// Localized<string> | null
  description Json?
  /// Localized<string> | null — tarkibi
  ingredients Json?
  /// Localized<string> | null — saqlash sharoiti
  storage     Json?

  /// Localized<string> | null — ta'mi (olma, shaftoli, ...)
  flavor Json?

  /// Yaroqlilik muddati (kun).
  shelfLifeDays Int?

  /// Ozuqaviy qiymat: { per100ml: { energyKcal, protein, carbs, sugar, fat } }
  /// Aniq tuzilma S12 da mijoz ma'lumoti bilan qat'iylashtiriladi.
  nutrition Json?

  seo Json?

  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  variants   ProductVariant[]
  images     ProductImage[]
  documents  ProductDocument[]
  priceRules PriceRule[]

  @@index([categoryId])
  @@index([isActive, displayOrder])
  @@index([createdAt])
  @@map("products")
}

/// Mahsulot varianti — hajm bo'yicha (0.5 l, 1 l, ...).
model ProductVariant {
  id String @id @default(uuid(7)) @db.Uuid

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku     String  @unique
  barcode String? @unique

  /// Hajm millilitrda. Butun son: 0.5 l -> 500.
  volumeMl Int

  /// Bir qadoqdagi dona soni (masalan 12 tali blok).
  unitsPerPack Int?

  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  prices     ProductPrice[]
  priceRules PriceRule[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  stock          WarehouseStock[]
  stockMovements StockMovement[]

  /// Eng kam buyurtma miqdori (dona). `null` — cheklov yo'q.
  minOrderQuantity Int?

  @@index([productId, isActive])
  @@map("product_variants")
}

model ProductImage {
  id String @id @default(uuid(7)) @db.Uuid

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  mediaAssetId String     @db.Uuid
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  /// Asosiy rasm — ro'yxatlarda ko'rsatiladi.
  isPrimary    Boolean @default(false)
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())

  @@unique([productId, mediaAssetId])
  @@index([productId, displayOrder])
  @@map("product_images")
}

model ProductDocument {
  id String @id @default(uuid(7)) @db.Uuid

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  mediaAssetId String     @db.Uuid
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  /// Localized<string>
  title Json
  kind  ProductDocumentKind @default(OTHER)

  displayOrder Int @default(0)

  createdAt DateTime @default(now())

  @@unique([productId, mediaAssetId])
  @@index([productId])
  @@map("product_documents")
}

/// Variant narxi.
///
/// Diler darajalariga bog'liq narxlar S23 da qo'shiladi; bu yerda
/// asosiy (ro'yxat) narxi.
model ProductPrice {
  id String @id @default(uuid(7)) @db.Uuid

  variantId String         @db.Uuid
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  /// DIQQAT: summa BUTUN SONDA, eng kichik birlikda (tiyin) saqlanadi.
  /// Suzuvchi nuqta ishlatilsa, narxlar yig'indisida xato to'planardi.
  amount   Int
  currency String @default("UZS")

  /// Amal qilish oralig'i. `validTo` bo'sh bo'lsa — hozirgi narx.
  validFrom DateTime  @default(now())
  validTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([variantId, validFrom])
  @@map("product_prices")
}

// =============================================================================
// KONTENT (S10)
// =============================================================================

/// Nashr holati.
///
/// `DRAFT` yozuvlar ommaviy API'da HECH QACHON ko'rinmaydi. Bu shart
/// servis qatlamida markazlashtirilgan — har so'rovda qo'lda yozilsa,
/// birortasida unutilishi va tayyor bo'lmagan matn saytga chiqib ketishi
/// aniq.
enum ContentStatus {
  DRAFT
  PUBLISHED
}

/// Yangilik / maqola.
model NewsArticle {
  id String @id @default(uuid(7)) @db.Uuid

  slug String @unique

  /// Localized<string>
  title   Json
  /// Localized<string> | null — qisqa mazmun (ro'yxatlarda)
  excerpt Json?
  /// Localized<string> — to'liq matn
  body    Json

  coverImageId String?     @db.Uuid
  coverImage   MediaAsset? @relation("NewsCover", fields: [coverImageId], references: [id], onDelete: SetNull)

  status      ContentStatus @default(DRAFT)
  /// Nashr sanasi. Kelajakdagi sana — rejalashtirilgan nashr.
  publishedAt DateTime?

  seo Json?

  authorId String? @db.Uuid
  author   User?   @relation("NewsAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status, publishedAt])
  @@index([createdAt])
  @@map("news")
}

/// Sertifikat / sifat hujjati.
///
/// DIQQAT: sertifikatlar O'YLAB TOPILMAYDI (CLAUDE.md §19). Yozuv faqat
/// haqiqiy hujjat yuklangandan keyin nashr qilinadi.
model Certificate {
  id String @id @default(uuid(7)) @db.Uuid

  /// Localized<string>
  title       Json
  /// Localized<string> | null
  description Json?

  /// Kim bergan (organ nomi).
  issuer String?
  /// Sertifikat raqami.
  number String?

  issuedAt  DateTime?
  expiresAt DateTime?

  /// Hujjat fayli (PDF yoki rasm).
  mediaAssetId String?     @db.Uuid
  mediaAsset   MediaAsset? @relation("CertificateFile", fields: [mediaAssetId], references: [id], onDelete: SetNull)

  status       ContentStatus @default(DRAFT)
  displayOrder Int           @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status, displayOrder])
  @@map("certificates")
}

/// Galereya elementi (zavod fotolari, mahsulot suratlari).
model GalleryItem {
  id String @id @default(uuid(7)) @db.Uuid

  mediaAssetId String     @db.Uuid
  mediaAsset   MediaAsset @relation("GalleryMedia", fields: [mediaAssetId], references: [id], onDelete: Cascade)

  /// Localized<string> | null
  caption Json?
  /// Guruhlash uchun: `factory`, `products`, `events`.
  album   String?

  status       ContentStatus @default(DRAFT)
  displayOrder Int           @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status, album, displayOrder])
  @@map("gallery_items")
}

/// Ommaviy hujjat (katalog, narxlar ro'yxati, shartnoma namunasi).
model PublicDocument {
  id String @id @default(uuid(7)) @db.Uuid

  /// Localized<string>
  title       Json
  /// Localized<string> | null
  description Json?

  mediaAssetId String     @db.Uuid
  mediaAsset   MediaAsset @relation("PublicDocumentFile", fields: [mediaAssetId], references: [id], onDelete: Cascade)

  status       ContentStatus @default(DRAFT)
  displayOrder Int           @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status, displayOrder])
  @@map("documents")
}

/// Ishlab chiqarish bosqichi (CLAUDE.md §4).
///
/// Sakkiz bosqich matn va rasm bilan birga CMS'dan boshqariladi, kodda
/// qattiq yozilmaydi — tarjimalar va tavsiflar o'zgarishi mumkin.
model ProductionStep {
  id String @id @default(uuid(7)) @db.Uuid

  /// `xomashyo`, `qabul-qilish`, ... — kodda havola qilish uchun.
  slug String @unique

  /// Localized<string>
  title       Json
  /// Localized<string> | null
  description Json?

  mediaAssetId String?     @db.Uuid
  mediaAsset   MediaAsset? @relation("ProductionStepMedia", fields: [mediaAssetId], references: [id], onDelete: SetNull)

  status       ContentStatus @default(DRAFT)
  displayOrder Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, displayOrder])
  @@map("production_steps")
}

/// Sahifa uchun SEO meta (CLAUDE.md §19).
model SeoMetadata {
  id String @id @default(uuid(7)) @db.Uuid

  /// Sahifa yo'li: `/`, `/products`, `/news/anor-sharbati`.
  path String @unique

  /// Localized<string> | null
  title       Json?
  /// Localized<string> | null
  description Json?

  ogImageId String?     @db.Uuid
  ogImage   MediaAsset? @relation("SeoOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)

  /// `true` bo'lsa sahifa indekslanmaydi.
  noIndex Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("seo_metadata")
}

/// Bosh sahifa bo'limi (hero va boshqalar).
///
/// Bo'limlar ro'yxati CMS'dan boshqariladi: matn, rasm va tartib
/// o'zgarishi uchun deploy kerak bo'lmasligi lozim (CLAUDE.md §8).
model HomepageSection {
  id String @id @default(uuid(7)) @db.Uuid

  /// `hero`, `stats`, `factory`, `products`, `process`, `quality`, `cta`, `news`
  key String @unique

  /// Localized<string> | null
  heading    Json?
  /// Localized<string> | null
  subheading Json?
  /// Localized<string> | null — tugma matni
  ctaLabel   Json?
  ctaHref    String?

  mediaAssetId String?     @db.Uuid
  mediaAsset   MediaAsset? @relation("HomepageMedia", fields: [mediaAssetId], references: [id], onDelete: SetNull)

  status       ContentStatus @default(DRAFT)
  displayOrder Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, displayOrder])
  @@map("homepage_sections")
}

// =============================================================================
// B2B LEADLAR VA BILDIRISHNOMALAR (CLAUDE.md §9, §21)
// =============================================================================

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  NEGOTIATION
  CONVERTED
  REJECTED
}

enum BusinessType {
  DISTRIBUTOR
  WHOLESALE
  RETAIL
  HORECA
  OTHER
}

/// Ommaviy saytdan kelgan hamkorlik arizasi.
///
/// Bu yozuvlarni ANONIM foydalanuvchi yaratadi, shuning uchun manba
/// ma'lumoti (IP, user agent) saqlanadi — spam tahlili va takroriy
/// yuborishni cheklash uchun. Shaxsiy ma'lumot minimal: faqat forma
/// maydonlari.
model Lead {
  id String @id @default(uuid(7)) @db.Uuid

  companyName String
  contactName String
  phone       String
  email       String?
  region      String

  businessType BusinessType

  desiredProducts        String?
  estimatedMonthlyVolume Int?
  message                String?

  status LeadStatus @default(NEW)

  /// Kim yuritmoqda (sotuvchi).
  assignedToId String? @db.Uuid
  assignedTo   User?   @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  /// Takroriy yuborishni aniqlash uchun: normallashtirilgan telefon + kompaniya.
  /// Yagona EMAS — bir kompaniya qayta murojaat qilishi mumkin; bu faqat
  /// qisqa vaqt ichidagi takrorni topish uchun indeks.
  dedupeKey String

  /// So'rov manbai. Shaxsni aniqlash uchun emas, suiiste'molni
  /// cheklash uchun saqlanadi.
  ip        String?
  userAgent String?

  events LeadEvent[]

  /// Ariza dilerga aylangan bo'lsa (CONVERTED).
  dealers Dealer[] @relation("LeadDealer")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status, createdAt])
  @@index([dedupeKey, createdAt])
  @@index([assignedToId])
  @@map("leads")
}

/// Lead tarixi: holat o'zgarishi va izohlar.
model LeadEvent {
  id String @id @default(uuid(7)) @db.Uuid

  leadId String @db.Uuid
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  fromStatus LeadStatus?
  toStatus   LeadStatus

  note String?

  actorId String? @db.Uuid
  actor   User?   @relation("LeadEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
  @@map("lead_events")
}

enum NotificationChannel {
  IN_APP
  TELEGRAM
  EMAIL
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

/// Yuborilgan (yoki yuborilmoqchi bo'lgan) bildirishnoma.
///
/// Har bir urinish yoziladi: provayder ishlamay qolsa, nima
/// yuborilmagani ko'rinib turadi. `payload` da HECH QACHON parol yoki
/// token bo'lmaydi (CLAUDE.md §23).
model Notification {
  id String @id @default(uuid(7)) @db.Uuid

  /// `lead.created`, `order.status_changed`, ...
  event   String
  channel NotificationChannel

  /// Kimga: foydalanuvchi (in-app) yoki tashqi manzil (chat id, email).
  recipientId      String? @db.Uuid
  recipient        User?   @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  recipientAddress String?

  subject String?
  body    String

  /// Qo'shimcha ma'lumot (entity id va h.k.).
  payload Json?

  status   NotificationStatus @default(PENDING)
  error    String?
  attempts Int                @default(0)
  sentAt   DateTime?
  /// In-app uchun: o'qilgan vaqti.
  readAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([recipientId, readAt])
  @@index([event, createdAt])
  @@map("notifications")
}

// =============================================================================
// DILERLAR (CLAUDE.md §5)
// =============================================================================

enum DealerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

/// Diler darajasi: narx siyosatining asosi (S23).
///
/// Chegirma FOIZ emas, BAZIS PUNKT (foizning yuzdan bir ulushi):
/// 250 = 2.5%. Sabab — pul hisobida kasr son ishlatilmaydi
/// (`product_prices` ham butun tiyinda). 2.5% ni `0.025` sifatida
/// saqlash yaxlitlash xatolarini keltirib chiqarardi.
model DealerTier {
  id String @id @default(uuid(7)) @db.Uuid

  /// Barqaror kod: `BRONZE`, `SILVER`, `GOLD`. Narx qoidalari shunga
  /// bog'lanadi, shuning uchun u nomdan ALOHIDA — nom o'zgarishi
  /// mumkin, kod esa yo'q.
  code String @unique
  name String

  discountBasisPoints Int @default(0)

  /// Shu darajadagi diler uchun eng kam buyurtma summasi (tiyinda).
  minOrderAmount Int?

  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  dealers    Dealer[]
  priceRules PriceRule[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([isActive, displayOrder])
  @@map("dealer_tiers")
}

/// Diler tashkiloti.
///
/// BIR FOYDALANUVCHI = BIR DILER (hozircha). `userId` yagona, ya'ni
/// bitta akkaunt ikkita tashkilotga kira olmaydi. Ko'p kontaktli
/// tashkilot kerak bo'lsa, bu alohida jadval bilan kengaytiriladi —
/// lekin hozir kerak emas va soddaligi tekshiruvni ishonchli qiladi.
///
/// `status` KIRISH HUQUQINI hal qiladi: faqat `APPROVED` diler
/// endpoint'lariga kira oladi. Tekshiruv SERVERDA (`DealerGuard`),
/// panelda tugma yashirish bilan emas (CLAUDE.md §3).
model Dealer {
  id String @id @default(uuid(7)) @db.Uuid

  /// Kirish akkaunti. Ariza tasdiqlanmaguncha ham mavjud bo'ladi —
  /// diler o'z arizasi holatini ko'ra olishi kerak.
  userId String @unique @db.Uuid
  user   User   @relation("DealerAccount", fields: [userId], references: [id], onDelete: Cascade)

  companyName String
  /// STIR / INN — O'zbekistonda 9 raqam. Yagona: bir tashkilot ikki
  /// marta ro'yxatdan o'ta olmaydi.
  taxId       String? @unique
  region      String

  businessType BusinessType

  status DealerStatus @default(PENDING)

  tierId String?     @db.Uuid
  tier   DealerTier? @relation(fields: [tierId], references: [id], onDelete: SetNull)

  /// Kredit limiti (tiyinda). `null` — limit yo'q, faqat oldindan to'lov.
  creditLimit Int?

  /// Ichki izoh — DILERGA KO'RSATILMAYDI. Rad etish sababi mijozga
  /// alohida maydonda (`statusReason`) beriladi.
  internalNote String?
  /// Oxirgi holat o'zgarishining sababi; dilerga ko'rsatiladi.
  statusReason String?

  /// Arizani kim ko'rib chiqdi.
  reviewedById String?   @db.Uuid
  reviewedBy   User?     @relation("DealerReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  /// Ariza qaysi lead'dan o'sib chiqqan (bo'lsa). `SetNull`: lead
  /// o'chirilsa diler qolaveradi.
  leadId String? @db.Uuid
  lead   Lead?   @relation("LeadDealer", fields: [leadId], references: [id], onDelete: SetNull)

  addresses  DealerAddress[]
  events     DealerEvent[]
  priceRules PriceRule[]
  cart       Cart?
  orders     Order[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status, createdAt])
  @@index([tierId])
  @@index([region])
  @@map("dealers")
}

/// Yetkazib berish manzili.
///
/// STANDART MANZIL bittadan ko'p bo'lmasligi kerak. Buni qisman
/// indeks bilan bazada qo'riqlash mumkin emas (Prisma uni
/// ifodalamaydi), shuning uchun servis standartni bitta tranzaksiya
/// ichida almashtiradi.
model DealerAddress {
  id String @id @default(uuid(7)) @db.Uuid

  dealerId String @db.Uuid
  dealer   Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  /// Ichki nom: "Asosiy ombor", "Chilonzor do'koni".
  label String

  region   String
  district String?
  city     String?
  street   String
  /// Qo'shimcha: mo'ljal, qavat, kirish.
  notes    String?

  contactName  String
  /// 998XXXXXXXXX ko'rinishida (`@barff/utils` normalizePhone).
  contactPhone String

  isDefault Boolean @default(false)

  orders Order[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([dealerId, isDefault])
  @@map("dealer_addresses")
}

/// Diler tarixi: holat o'zgarishi va izohlar.
///
/// `audit_logs` dan FARQI: bu diler oqimining O'Z tarixi va u
/// dilerning o'ziga ham ko'rsatiladi (arizam qanday ketyapti).
/// Audit jurnali esa ichki va butun tizim bo'ylab.
model DealerEvent {
  id String @id @default(uuid(7)) @db.Uuid

  dealerId String @db.Uuid
  dealer   Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  fromStatus DealerStatus?
  toStatus   DealerStatus

  note String?

  actorId String? @db.Uuid
  actor   User?   @relation("DealerEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([dealerId, createdAt])
  @@map("dealer_events")
}

// =============================================================================
// NARX QOIDALARI (CLAUDE.md §5)
// =============================================================================

enum PriceRuleKind {
  /// Bazaviy narx O'RNIGA qo'yiladigan qat'iy narx (tiyinda).
  FIXED_PRICE
  /// Foizli chegirma, bazis punktda (250 = 2.5%).
  PERCENT_DISCOUNT
  /// Qat'iy summali chegirma (tiyinda).
  AMOUNT_DISCOUNT
}

/// Narx qoidasi.
///
/// NEGA BITTA JADVAL, NEGA HAR TURGA ALOHIDA EMAS: daraja narxi,
/// hududiy narx, hajm chegirmasi va aksiya — bularning hammasi bir
/// xil savolga javob beradi ("shu dilerga, shu variant uchun, shu
/// miqdorda qancha?"). Alohida jadvallarda ularning USTUNLIGINI
/// aniqlash kod bo'ylab tarqalib ketardi va "qaysi narx qo'llandi"
/// degan savolga javob berib bo'lmasdi.
///
/// QAMROV maydonlari `null` bo'lsa — "hammasi uchun". Qancha ko'p
/// maydon to'ldirilgan bo'lsa, qoida shuncha ANIQ va shuncha
/// ustunroq (`PriceResolver.specificity`).
model PriceRule {
  id String @id @default(uuid(7)) @db.Uuid

  /// Inson o'qiydigan nom — admin panelda ko'rinadi.
  name String

  kind PriceRuleKind

  /// Ma'nosi `kind` ga bog'liq: tiyin yoki bazis punkt.
  amount   Int
  currency String @default("UZS")

  // --- QAMROV: qaysi mahsulotga -------------------------------------------
  variantId  String?          @db.Uuid
  variant    ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  productId  String?          @db.Uuid
  product    Product?         @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId String?          @db.Uuid
  category   ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // --- QAMROV: kimga -------------------------------------------------------
  dealerId String?     @db.Uuid
  dealer   Dealer?     @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  tierId   String?     @db.Uuid
  tier     DealerTier? @relation(fields: [tierId], references: [id], onDelete: Cascade)
  /// Hudud nomi. Diler manzilidan emas, DILER yozuvidan olinadi.
  region   String?

  // --- SHART ---------------------------------------------------------------
  /// Shu miqdordan boshlab amal qiladi (hajm chegirmasi shu orqali).
  minQuantity Int @default(1)

  /// Aksiya kodi. Berilgan bo'lsa, qoida FAQAT kod kiritilganda
  /// hisobga olinadi — aks holda har bir mijoz uni bilmasdan olardi.
  code String? @unique

  // --- AMAL QILISH ---------------------------------------------------------
  validFrom DateTime  @default(now())
  validTo   DateTime?

  isActive Boolean @default(true)

  /// Qo'lda ustunlik. Aniqlik BIR XIL bo'lgan ikki qoida uchun hal
  /// qiluvchi belgi; katta son ustun.
  priority Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([isActive, validFrom, validTo])
  @@index([variantId])
  @@index([productId])
  @@index([categoryId])
  @@index([dealerId])
  @@index([tierId])
  @@map("price_rules")
}

// =============================================================================
// SAVAT (CLAUDE.md §5)
// =============================================================================

/// Diler savati.
///
/// SERVERDA saqlanadi, brauzer xotirasida EMAS. Sabab amaliy: diler
/// telefonda savat yig'ib, buyurtmani kompyuterda yakunlashi mumkin
/// (`ROADMAP.md` S25 DoD: "cart survives device switch").
///
/// HAR BIR DILERDA BITTA savat: `dealerId` yagona. Ko'p savat kerak
/// bo'lsa (masalan turli manzillarga) bu keyin kengaytiriladi —
/// hozir soddaligi oqimni ishonchli qiladi.
model Cart {
  id String @id @default(uuid(7)) @db.Uuid

  dealerId String @unique @db.Uuid
  dealer   Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  /// Mijoz kiritgan aksiya kodi. Narx HAR SAFAR qayta hisoblanadi,
  /// ya'ni kod muddati tugasa savat o'zi yangilanadi.
  promoCode String?

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("carts")
}

/// Savat pozitsiyasi.
///
/// DIQQAT: bu yerda NARX SAQLANMAYDI — faqat variant va miqdor.
///
/// Narxni savatga yozish eng keng tarqalgan xato bo'lardi: mijoz
/// savatni bir hafta ochiq qoldirsa, narx o'zgargan bo'lsa ham
/// eskisi qolardi. Narx HAR SAFAR `PricingService` orqali qayta
/// hisoblanadi (CLAUDE.md §5: narx faqat bitta joyda hisoblanadi).
model CartItem {
  id String @id @default(uuid(7)) @db.Uuid

  cartId String @db.Uuid
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  variantId String         @db.Uuid
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  quantity Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Bitta variant savatda IKKI MARTA turmaydi — miqdor qo'shiladi.
  @@unique([cartId, variantId])
  @@index([cartId])
  @@map("cart_items")
}

// =============================================================================
// BUYURTMALAR (CLAUDE.md §5, §28)
// =============================================================================

enum OrderStatus {
  DRAFT
  PENDING_REVIEW
  CONFIRMED
  RESERVED
  PICKING
  PACKED
  READY_FOR_DELIVERY
  DRIVER_ASSIGNED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

/// Diler buyurtmasi.
///
/// NARX BU YERDA MUZLATILADI (`order_items`). Savatda narx har safar
/// qayta hisoblanadi (S25), lekin BUYURTMA YUBORILGAN lahzadan
/// boshlab u o'zgarmaydi: mijoz ko'rgan summa bilan hisob-faktura
/// FARQ QILMASLIGI kerak.
model Order {
  id String @id @default(uuid(7)) @db.Uuid

  /// Inson o'qiydigan raqam: `BRF-2026-000123`. Yagona.
  number String @unique

  dealerId String @db.Uuid
  dealer   Dealer @relation(fields: [dealerId], references: [id], onDelete: Restrict)

  status OrderStatus @default(PENDING_REVIEW)

  /**
   * YETKAZIB BERISH MANZILI NUSXA sifatida saqlanadi.
   * Havola YETARLI EMAS: diler manzilni keyinchalik tahrirlashi yoki
   * o'chirishi mumkin, va o'shanda eski buyurtma QAYERGA yetkazilgani
   * yo'qolardi. Havola ham qoldiriladi (tahlil uchun), lekin matn
   * buyurtmaning O'ZIDA.
   */
  addressId       String?        @db.Uuid
  address         DealerAddress? @relation(fields: [addressId], references: [id], onDelete: SetNull)
  shippingLabel   String
  shippingRegion  String
  shippingAddress String
  contactName     String
  contactPhone    String
  /// Mo'ljal, qavat, kirish.
  shippingNotes   String?

  /// Diler izohi — diler yozadi va u KO'RADI.
  note String?

  /// Xodimlar izohi — DILERGA KO'RSATILMAYDI.
  ///
  /// Dilerga qaytariladigan maydonlar ro'yxati (`ORDER_SELECT`) da
  /// bu maydon ATAYLAB yo'q. Sabab dilerlar domenidagi bilan bir xil
  /// (S22): ichki eslatma mijozga chiqib ketmasligi kerak.
  internalNote String?

  /// Buyurtma paytidagi aksiya kodi — tahlil va nizolar uchun.
  promoCode String?

  /// Pozitsiyalar yig'indisi (tiyin). Yuborish paytida muzlatiladi.
  subtotal Int
  /// Umumiy chegirma (tiyin) — `basePrice` va `unitPrice` farqi.
  discount Int    @default(0)
  /// To'lanishi kerak summa (tiyin). Hozircha `subtotal` ga teng;
  /// yetkazib berish narxi va soliq S34+ da qo'shiladi.
  total    Int
  currency String @default("UZS")

  /**
   * Takroriy yuborishga qarshi kalit.
   * Mijoz tugmani ikki marta bossa yoki tarmoq uzilib qayta yuborsa,
   * IKKITA buyurtma yaratilmasligi kerak. Kalit diler bo'yicha
   * yagona: bir xil kalit bilan kelgan ikkinchi so'rov MAVJUD
   * buyurtmani qaytaradi.
   */
  idempotencyKey String?

  items   OrderItem[]
  history OrderStatusHistory[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([dealerId, idempotencyKey])
  @@index([dealerId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("orders")
}

/// Buyurtma pozitsiyasi — NARX MUZLATILGAN holda.
///
/// Mahsulot nomi ham NUSXA sifatida saqlanadi: mahsulot keyin
/// o'zgartirilsa yoki o'chirilsa, eski buyurtmada NIMA buyurtma
/// qilingani yo'qolmasligi kerak.
model OrderItem {
  id String @id @default(uuid(7)) @db.Uuid

  orderId String @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// `Restrict`: pozitsiyasi bor variantni o'chirib bo'lmaydi.
  variantId String         @db.Uuid
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  /// Yuborish paytidagi nusxalar.
  sku         String
  productName Json
  volumeMl    Int

  quantity Int

  /// Chegirmasiz narx (tiyin, bir dona).
  basePrice Int
  /// Qo'llangan narx (tiyin, bir dona).
  unitPrice Int
  /// `unitPrice * quantity`.
  total     Int

  /// Qaysi qoida qo'llangani — nizo chiqsa javob shu yerda.
  appliedRuleId   String? @db.Uuid
  appliedRuleName String?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

/// Holat tarixi — HAR BIR o'tish yoziladi (CLAUDE.md §23).
model OrderStatusHistory {
  id String @id @default(uuid(7)) @db.Uuid

  orderId String @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  fromStatus OrderStatus?
  toStatus   OrderStatus

  note String?

  /// Kim o'zgartirdi. `null` — tizim (avtomatik o'tish).
  actorId String? @db.Uuid
  actor   User?   @relation("OrderStatusActor", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

/// Buyurtma raqami uchun hisoblagich.
///
/// NEGA ALOHIDA JADVAL: `COUNT(*) + 1` poyga sharoitida ikki bir xil
/// raqam berardi. Bu yerda `UPDATE ... RETURNING` atomar oshiradi.
/// Yil bo'yicha: har yil 1 dan boshlanadi.
model OrderCounter {
  year  Int @id
  value Int @default(0)

  @@map("order_counters")
}

/// Amaldagi refresh token.
///
/// JWT o'zi bekor qilinmaydi — imzo to'g'ri bo'lsa, u muddati tugaguncha
/// amal qiladi. Shuning uchun "amaldagi" token'lar ro'yxati alohida
/// saqlanadi: chiqish (logout) va almashtirish (rotation) shu ro'yxatdan
/// o'chirish orqali ishlaydi.
///
/// NEGA BAZADA, REDIS'DA EMAS: bu xavfsizlik holati, kesh emas. Redis
/// qayta ishga tushsa ro'yxat yo'qolardi va BARCHA foydalanuvchilar
/// tizimdan chiqib ketardi. Bundan tashqari joylash muhitida (cPanel)
/// Redis umuman yo'q (`docs/OPEN-QUESTIONS.md` Q18).
model RefreshToken {
  id String @id @default(uuid(7)) @db.Uuid

  userId String @db.Uuid
  user   User   @relation("UserRefreshTokens", fields: [userId], references: [id], onDelete: Cascade)

  /// JWT `jti` da'vosi — token nusxasini aniqlaydi.
  jti    String
  /// Sessiya oilasi: almashtirishda yangi token o'sha oilada qoladi.
  family String

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([userId, jti])
  @@index([userId, family])
  /// Muddati o'tganlarini tozalash uchun.
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Refresh token OILASI — bitta sessiya.
///
/// Ishlatilgan token qayta taqdim etilsa, butun oila bekor qilinadi:
/// haqiqiy foydalanuvchi qayta kiradi, o'g'ri esa kira olmaydi.
model RefreshTokenFamily {
  id String @id @default(uuid(7)) @db.Uuid

  userId String @db.Uuid
  user   User   @relation("UserRefreshFamilies", fields: [userId], references: [id], onDelete: Cascade)

  family String

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([userId, family])
  @@index([expiresAt])
  @@map("refresh_token_families")
}

/// Muvaffaqiyatsiz kirish urinishlari hisoblagichi.
///
/// Kalit ikki turda bo'ladi: `email:<email>` va `ip:<ip>`. Birinchisi
/// bitta akkauntni parol tanlashdan, ikkinchisi bitta manbadan ko'p
/// akkauntni sinashdan himoya qiladi.
///
/// Redis'da bu `INCR` + `EXPIRE` edi. Bazada muddat AVTOMATIK o'chmaydi,
/// shuning uchun o'qishda `expiresAt` tekshiriladi va yozishda muddati
/// o'tgan qatorlar tozalanadi.
model LoginAttempt {
  /// `email:<email>` yoki `ip:<ip>`.
  key String @id

  count Int @default(0)

  /// Shu paytdan keyin hisoblagich kuchini yo'qotadi.
  expiresAt DateTime

  updatedAt DateTime @updatedAt

  @@index([expiresAt])
  @@map("login_attempts")
}

// =============================================================================
// OMBOR (CLAUDE.md §7)
// =============================================================================

/// Ombor harakati turi.
///
/// `RESERVED` va `RELEASED` jismoniy qoldiqqa TEGMAYDI — ular faqat
/// band qilingan ulushni o'zgartiradi. Qolganlari jismoniy qoldiqni
/// o'zgartiradi.
enum StockMovementType {
  IN
  OUT
  RESERVED
  RELEASED
  TRANSFER
  ADJUSTMENT
  RETURN
}

model Warehouse {
  id String @id @default(uuid(7)) @db.Uuid

  /// Qisqa kod: `MAIN`, `SMQ-1`. Hujjatlarda va ekranlarda ishlatiladi.
  code String @unique
  name String

  region  String
  address String?
  notes   String?

  isActive Boolean @default(true)

  /// Standart ombor — yangi kelim shu yerga tushadi.
  ///
  /// Yagonaligi qisman indeks bilan ta'minlanadi (migratsiyada):
  /// ikkita standart ombor bo'lsa, "qayerga" degan savol javobsiz
  /// qolardi.
  isDefault Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  stock            WarehouseStock[]
  movements        StockMovement[]  @relation("MovementWarehouse")
  /// Ko'chirishning IKKINCHI tomoni (`TRANSFER`).
  relatedMovements StockMovement[]  @relation("MovementRelatedWarehouse")

  @@index([isActive])
  @@map("warehouses")
}

/// Ombordagi joriy qoldiq.
///
/// BU JADVAL QO'LDA YOZILMAYDI. U `stock_movements` ning
/// PROYEKSIYASI: har bir harakat bazadagi trigger orqali shu yerga
/// qo'llanadi va to'g'ridan-to'g'ri `UPDATE` REDD ETILADI
/// (`ROADMAP.md` S30 DoD: "stock can never change without a movement
/// row"). Servis intizomi yetarli emas — uni chetlab o'tish mumkin.
model WarehouseStock {
  id String @id @default(uuid(7)) @db.Uuid

  warehouseId String    @db.Uuid
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  productVariantId String         @db.Uuid
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  /// Jismoniy qoldiq (dona). Hech qachon manfiy bo'lmaydi.
  quantity Int @default(0)

  /// Shundan band qilingani. `quantity` dan katta bo'la olmaydi.
  reservedQuantity Int @default(0)

  /// Shu darajadan pastda bildirishnoma yuboriladi (S31). `null` — kuzatilmaydi.
  lowStockThreshold Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([warehouseId, productVariantId])
  @@index([productVariantId])
  @@map("warehouse_stock")
}

/// Qoldiq harakatlari — QO'SHILADIGAN, o'zgartirilmaydigan jurnal.
///
/// Yagona haqiqat manbai shu jadval: `warehouse_stock` undan
/// hisoblanadi. Qator yozilgandan keyin TAHRIRLANMAYDI va
/// O'CHIRILMAYDI (xato harakat `ADJUSTMENT` bilan to'g'rilanadi) —
/// buni ham trigger ta'minlaydi.
model StockMovement {
  id String @id @default(uuid(7)) @db.Uuid

  warehouseId String    @db.Uuid
  warehouse   Warehouse @relation("MovementWarehouse", fields: [warehouseId], references: [id], onDelete: Restrict)

  productVariantId String         @db.Uuid
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  type StockMovementType

  /// Miqdor (dona).
  ///
  /// ISHORA MUHIM: `ADJUSTMENT` va `TRANSFER` da manfiy bo'lishi
  /// mumkin (kamaytirish, ko'chirishning chiquvchi tomoni).
  /// Qolgan turlarda MUSBAT — ishorani turning o'zi belgilaydi
  /// (`OUT` kamaytiradi, `IN` oshiradi).
  quantity Int

  /// Harakatdan KEYINGI holat. Trigger yozadi.
  ///
  /// Jurnalni o'qish uchun shart: aks holda har bir qatorning
  /// ta'sirini bilish uchun butun tarixni boshidan yig'ish kerak
  /// bo'lardi.
  quantityAfter Int @default(0)
  reservedAfter Int @default(0)

  /// `ADJUSTMENT` uchun SHART (S30 DoD). Qolganlari uchun ixtiyoriy.
  reason String?

  /// Tashqi havola: buyurtma raqami, kelim hujjati va h.k.
  reference String?

  /// Ko'chirishning ikkinchi tomoni.
  relatedWarehouseId String?    @db.Uuid
  relatedWarehouse   Warehouse? @relation("MovementRelatedWarehouse", fields: [relatedWarehouseId], references: [id], onDelete: SetNull)

  /// Kim bajardi. Tizim harakatlari uchun `null` (masalan buyurtma zaxirasi).
  actorId String? @db.Uuid
  actor   User?   @relation("StockMovementActor", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([warehouseId, createdAt])
  @@index([productVariantId, createdAt])
  @@index([type, createdAt])
  @@map("stock_movements")
}
