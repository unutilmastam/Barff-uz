# Aloqa formasi yuboriladigan OCHIQ endpoint.
# Bu qiymat brauzerga chiqadi — bu yerga token yoki API kalit YOZILMAYDI.
# Odatda o'z serverimizdagi yo'l bo'ladi, masalan: /api/contact
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Maxfiy kalitlar (Telegram bot tokeni, email API kaliti va h.k.) SERVER tomonda,
# `NEXT_PUBLIC_` prefiksiSIZ saqlanadi va faqat server kodida o'qiladi:
# CONTACT_TELEGRAM_BOT_TOKEN=
# CONTACT_TELEGRAM_CHAT_ID=
