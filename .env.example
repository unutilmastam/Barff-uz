# =============================================================================
# BARFF PLATFORM — MUHIT O'ZGARUVCHILARI
#
# Bu faylda faqat NOMLAR turadi, QIYMATLAR EMAS (CLAUDE.md §12).
# Haqiqiy qiymatlar `.env` da (commit qilinmaydi), production'da esa
# AWS Secrets Manager'da saqlanadi.
# =============================================================================

# --- Umumiy ---------------------------------------------------------------
NODE_ENV=
LOG_LEVEL=

# --- API (services/api) ---------------------------------------------------
API_PORT=
API_BASE_URL=
API_CORS_ORIGINS=
API_RATE_LIMIT_TTL=
API_RATE_LIMIT_MAX=
# API oldidagi ishonchli proksi soni (Cloudflare -> ALB = 2, lokalda 0).
API_TRUST_PROXY_HOPS=
# Standart holatda production'dan tashqari hamma joyda yoniq.
SWAGGER_ENABLED=

# --- Ma'lumotlar bazasi (PostgreSQL / Prisma) -----------------------------
DATABASE_URL=
DATABASE_SHADOW_URL=

# Seed admin foydalanuvchisi (S03). Parol berilmasa lokal/staging'da
# bir martalik tasodifiy parol yaratiladi; production'da esa MAJBURIY.
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=

# --- Redis ----------------------------------------------------------------
REDIS_URL=

# --- Obyekt saqlash (S3 / MinIO) ------------------------------------------
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# MinIO subdomen ko'rinishidagi bucket manzillarini qo'llab-quvvatlamaydi.
S3_FORCE_PATH_STYLE=
# Ommaviy fayllar beriladigan CDN manzili. Bucket'ning O'ZI ochiq emas.
S3_PUBLIC_URL=

# --- Media (S08) ----------------------------------------------------------
MEDIA_MAX_BYTES=
MEDIA_SIGNED_URL_TTL=

# --- Autentifikatsiya (S04) -----------------------------------------------
# Access va refresh uchun ALOHIDA sirlar (har biri kamida 32 belgi).
# Yaratish: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=
# Cookie production'da har doim Secure (HTTPS) — u yerda o'chirib bo'lmaydi.
COOKIE_DOMAIN=
COOKIE_SECURE=
# Muvaffaqiyatsiz kirish urinishlari chegarasi va blok muddati.
AUTH_LOGIN_MAX_ATTEMPTS=
# IP chegarasi akkaunt chegarasidan ANCHA yuqori: bitta NAT ortida o'nlab
# foydalanuvchi turadi va ular bir-birini bloklab qo'ymasligi kerak.
AUTH_LOGIN_MAX_ATTEMPTS_PER_IP=
AUTH_LOGIN_LOCK_SECONDS=
# Ruxsatlar keshi (soniya). 0 — kesh o'chiq, har so'rovda bazadan o'qiladi.
AUTH_USER_CACHE_SECONDS=

# --- Frontend app'lar -----------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_DEALER_URL=
NEXT_PUBLIC_ADMIN_URL=
# Placeholder kontent qidiruvga tushmasligi uchun standart holatda o'chiq.
NEXT_PUBLIC_ALLOW_INDEXING=

# --- Bildirishnomalar (S14, S21) ------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMS_PROVIDER_API_KEY=

# --- Kuzatuv (S41) --------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
