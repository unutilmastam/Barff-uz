# ============================================================================
# SEO
# ============================================================================

# Saytning kanonik manzili (canonical, OG rasm va sitemap shu manzildan yasaladi).
# Berilmasa `https://barff.uz` ishlatiladi (CNAME faylidagi domen).
NEXT_PUBLIC_SITE_URL=

# INDEKSLASH. Standart holatda O'CHIQ.
# Sayt hozircha placeholder kontent bilan ("MAHSULOT 01", "[CLIENT CONTENT REQUIRED]") —
# bunday sahifalar Google'ga tushsa brendga zarar qiladi. Mijoz kontenti kelgach,
# ishga tushirish kunida `true` qilinadi:
NEXT_PUBLIC_ALLOW_INDEXING=

# ============================================================================
# ALOQA FORMASI
# ============================================================================

# Aloqa formasi yuboriladigan OCHIQ endpoint.
# Bu qiymat brauzerga chiqadi — bu yerga token yoki API kalit YOZILMAYDI.
# Odatda o'z serverimizdagi yo'l bo'ladi, masalan: /api/contact
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Maxfiy kalitlar (Telegram bot tokeni, email API kaliti va h.k.) SERVER tomonda,
# `NEXT_PUBLIC_` prefiksiSIZ saqlanadi va faqat server kodida o'qiladi:
# CONTACT_TELEGRAM_BOT_TOKEN=
# CONTACT_TELEGRAM_CHAT_ID=
