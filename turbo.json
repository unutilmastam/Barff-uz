{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": ["NODE_ENV"],

  // Turbo task'larga FAQAT shu yerda e'lon qilingan o'zgaruvchilarni
  // uzatadi, qolganlarini olib tashlaydi. Ular e'lon qilinmasa, testlar
  // `DATABASE_URL` ni ko'rmay, zaxira qiymatga tushib qolardi — va bu
  // lokalda sezilmasdi, chunki lokal baza parolsiz ulanishga ruxsat beradi.
  //
  // `globalEnv` emas, `globalPassThroughEnv`: bu qiymatlar qurish
  // natijasiga ta'sir qilmaydi, shuning uchun kesh kalitiga kirmasligi kerak.
  "globalPassThroughEnv": [
    "CI",

    // Tarmoq muhiti. `next/font/google` shriftlarni QURISH PAYTIDA
    // yuklab oladi, ya'ni build tarmoqqa bog'liq. Proksi orqali
    // ishlaydigan muhitda (masalan agent konteyneri) sertifikat
    // ro'yxatisiz bu "self-signed certificate in certificate chain"
    // bilan yiqiladi — va sabab turbo o'zgaruvchini olib
    // tashlaganida ekanini topish oson emas.
    "NODE_EXTRA_CA_CERTS",
    "HTTPS_PROXY",
    "HTTP_PROXY",
    "NO_PROXY",

    "LOG_LEVEL",
    "DATABASE_URL",
    "DATABASE_SHADOW_URL",
    "REDIS_URL",
    "API_PORT",
    "API_BASE_URL",
    "API_CORS_ORIGINS",
    "API_TRUST_PROXY_HOPS",
    "SWAGGER_ENABLED",
    "JWT_ACCESS_SECRET",
    "JWT_ACCESS_TTL",
    "JWT_REFRESH_SECRET",
    "JWT_REFRESH_TTL",
    "COOKIE_DOMAIN",
    "COOKIE_SECURE",
    "AUTH_LOGIN_MAX_ATTEMPTS",
    "AUTH_LOGIN_MAX_ATTEMPTS_PER_IP",
    "AUTH_LOGIN_LOCK_SECONDS",
    "AUTH_USER_CACHE_SECONDS",
    "SEED_ADMIN_EMAIL",
    "SEED_ADMIN_NAME",
    "SEED_ADMIN_PASSWORD"
  ],
  "globalDependencies": ["tsconfig.base.json", ".env.example", "prisma/schema.prisma"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],

      // `globalPassThroughEnv` EMAS, `env`: Next `NEXT_PUBLIC_*`
      // qiymatlarini qurish paytida bundle ICHIGA yozadi, ya'ni ular
      // build natijasini O'ZGARTIRADI va kesh kalitiga kirishi shart.
      // Ular e'lon qilinmaganida turbo ularni task'dan olib tashlagan
      // va sayt API manzilisiz qurilgan edi: barcha kontent sahifalari
      // "ma'lumot mavjud emas" holatida chiqardi, garchi API ishlab
      // tursa ham.
      "env": [
        "NEXT_PUBLIC_API_BASE_URL",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_DEALER_URL",
        "NEXT_PUBLIC_ADMIN_URL",
        "NEXT_PUBLIC_ALLOW_INDEXING"
      ],

      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "generated/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
